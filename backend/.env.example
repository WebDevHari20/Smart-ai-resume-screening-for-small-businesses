DATABASE_URL=sqlite:///./screener.db
# DATABASE_URL=postgresql://user:password@host:5432/screener
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=720
GITHUB_TOKEN=
ENABLE_EXTERNAL_VERIFICATION=true
USE_SBERT=true
SBERT_MODEL=all-MiniLM-L6-v2
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
# WhatsApp confirmation requests are disabled until explicitly configured.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PUBLIC_URL=https://your-domain.example/whatsapp/confirm
WHATSAPP_REQUEST_EXPIRY_HOURS=72
